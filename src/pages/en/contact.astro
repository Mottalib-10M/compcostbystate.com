---
import PageLayout from '../../layouts/PageLayout.astro';
import { route } from '../../i18n/routes';
import { CONTACT_EMAIL } from '../../data/site-config';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to Comp Cost By State about a workers comp rate, a class or a state coverage rule that changed. E-mail only: no quote, nothing passed on to an insurer or agent.';
---
<PageLayout title="Contact Comp Cost By State: report a rate or a rule that moved" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <article class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no phone line, and nothing you write is passed on to an insurer, an agent or anyone else.</p>
    <h2>What helps us most</h2>
    <ul>
      <li>A new edition of the Oregon premium rate ranking, or a state rate decision, with its link.</li>
      <li>A coverage rule we summarized wrong: quote the state agency page or the statute that says otherwise.</li>
      <li>The official employer page of a state we could not read.</li>
      <li>Embedding the calculator on a chamber of commerce, trade association or library page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not quote or sell insurance, recommend an insurer or an agent, review a claim or say how your business should be classified. Your insurer, a licensed agent and your state agency are the ones who can.</p>
  </article>
</PageLayout>
